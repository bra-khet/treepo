// Default multi-subject gallery for silhouette judgment (§6 + M0).
//
// Used by `m0-silhouette lab` and as the checklist for manual CLI sessions.
// Names under `corpus:` match tools/corpus shape names. `path:` is any repository on disk
// relative to the workspace root (or absolute). `pin:` names a tools/corpus pin.

(
    version: 1,
    subjects: [
        // AC-SKEL-2: seed + root cluster, not a lonely trunk.
        (id: "empty", corpus: "empty", covers: "AC-SKEL-2"),

        // AC-SKEL-1 comparable pair — same order of magnitude, opposite signals
        // (convention / language mix / hierarchy skew). Judge orderly vs wild together.
        (id: "skel1-clean", corpus: "skel1-clean", covers: "AC-SKEL-1 clean: conventional, single-language, balanced"),
        (id: "skel1-messy", corpus: "skel1-messy", covers: "AC-SKEL-1 messy: high-skew, mixed-language, unconventional"),

        // Narrow deep hierarchy — A3 / F-SKEL-7 containers visible.
        (id: "deep-nesting", corpus: "deep-nesting", covers: "A3 cap; F-SKEL-7 containers"),

        // Real multi-primary monorepo layout (treepo itself).
        (id: "self", path: ".", covers: "multi-primary basal stem; real layout"),

        // Optional: uncomment when pins are present under target/corpus-pinned.
        // (id: "ripgrep", pin: "ripgrep", covers: "clean T1 pin; real-repo AC-SKEL-1 candidate"),
    ],
)
